PORT=3000
MONGODB_URI=mongodb://localhost:27017/stuff-inventory

# Google OAuth client ID (Web application type) from https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
# Random string used to sign session tokens, e.g: openssl rand -hex 32
JWT_SECRET=
# Comma-separated list of Google account emails allowed to sign in
ALLOWED_EMAILS=

AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET_NAME=
